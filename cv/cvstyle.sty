% =============================================================================
%  cvstyle.sty: the site's design tokens, ported to paper.
%
%  This is the print counterpart of src/styles/global.css. Colours, fonts and
%  the asymmetric label/content grid are the same ones the website uses, so
%  the CV and the site read as one object. Change a value here, not in cv.tex.
%
%  Requires XeLaTeX (fontspec loads the TTFs in cv/fonts/).
% =============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/08/13 Ferran Alia CV style]

% \usepackage[dark]{cvstyle} builds the dark-theme cut. Same document, the
% other half of global.css: a screen-reading version, not a printing one.
\newif\ifcvdark
\DeclareOption{dark}{\cvdarktrue}
\DeclareOption{light}{\cvdarkfalse}
\ProcessOptions\relax

\RequirePackage{fontspec}
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{ragged2e}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage{eso-pic}
\RequirePackage{refcount}
\RequirePackage{calc}
\RequirePackage[a4paper,hmargin=18mm,vmargin=15mm,footskip=9mm]{geometry}
\RequirePackage[hidelinks,unicode]{hyperref}

% -----------------------------------------------------------------------------
%  Surfaces and ink
%
%  Straight out of global.css :root and :root[data-theme="dark"]. Both sets
%  are checked for contrast there, so neither needs rechecking here; what does
%  need care is that any colour added below exists in both.
% -----------------------------------------------------------------------------
\ifcvdark
  \definecolor{CvBg}{HTML}{0E2236}        % blueprint
  \definecolor{CvBgSunk}{HTML}{132B42}
  \definecolor{CvInk}{HTML}{E8EEF4}
  \definecolor{CvInkTwo}{HTML}{B5C3D1}
  \definecolor{CvInkThree}{HTML}{8FA3B7}
  \definecolor{CvRule}{HTML}{24425F}
  \definecolor{CvRuleStrong}{HTML}{3A5F82}
  \definecolor{CvAccent}{HTML}{8EC5FF}
  \definecolor{CvPencil}{HTML}{FF9C8A}
\else
  \definecolor{CvBg}{HTML}{F6F8F6}        % engineering paper
  \definecolor{CvBgSunk}{HTML}{EAF0EC}
  \definecolor{CvInk}{HTML}{18212D}
  \definecolor{CvInkTwo}{HTML}{465262}
  \definecolor{CvInkThree}{HTML}{5A6676}
  \definecolor{CvRule}{HTML}{CFD9D2}
  \definecolor{CvRuleStrong}{HTML}{A9B8AE}
  \definecolor{CvAccent}{HTML}{1D4E9E}
  \definecolor{CvPencil}{HTML}{B42318}
\fi

\pagecolor{CvBg}
\color{CvInk}

\hypersetup{
  colorlinks=true,
  allcolors=CvAccent,
  pdfborder={0 0 0},
  pdftitle={Ferran Alía Castillejos, curriculum vitae},
  pdfpagemode=UseNone,
  pdfauthor={Ferran Alía Castillejos},
  pdfsubject={Data science and physical engineering, UPC Barcelona},
  pdfcreator={XeLaTeX},
}

% -----------------------------------------------------------------------------
%  Type
%
%  Two families, as on the site: Source Serif 4 for headings and prose, and
%  Barlow Semi Condensed for dates, labels and the stack lines. Static cuts,
%  fetched by scripts/fetch_fonts.py; XeLaTeX takes only the default
%  instance of a variable font.
% -----------------------------------------------------------------------------
% Overridable so the CV can be built from a directory other than cv/.
\providecommand{\cvfontpath}{fonts/}
\ifcvdark
  \providecommand{\cvfigurepath}{figures/dark/}
\else
  \providecommand{\cvfigurepath}{figures/}
\fi

\defaultfontfeatures{Path=\cvfontpath, Extension=.ttf, Ligatures=TeX}

\setmainfont{SourceSerif4}[
  UprightFont = *-Regular,
  ItalicFont  = *-Italic,
  BoldFont    = *-SemiBold,
]

% Headings: the semibold cut, as h1-h3 in global.css.
\newfontfamily\cvdisplay{SourceSerif4}[
  UprightFont = *-SemiBold,
  BoldFont    = *-SemiBold,
  LetterSpace = -0.5,
]

% .u-meta in global.css: dates, places, tools. Sentence case, no tracking.
\newfontfamily\cvsans{BarlowSemiCondensed}[
  UprightFont = *-Regular,
  BoldFont    = *-Medium,
  Numbers     = Monospaced,
]

\newfontfamily\cvlabelfont{BarlowSemiCondensed}[
  UprightFont = *-Medium,
  BoldFont    = *-Medium,
  Numbers     = Monospaced,
]

% --- Ramp ---------------------------------------------------------------
% The print equivalent of --step--2 … --step-4. Sizes are pt/leading pairs;
% never write \fontsize by hand in cv.tex.
\newcommand{\cvStepMinusTwo}{\fontsize{6.6}{9}\selectfont}
\newcommand{\cvStepMinusOne}{\fontsize{8.3}{11.3}\selectfont}
\newcommand{\cvStepZero}{\fontsize{9.2}{12.2}\selectfont}
\newcommand{\cvStepOne}{\fontsize{11}{14}\selectfont}
\newcommand{\cvStepFour}{\fontsize{26.5}{29.5}\selectfont}

% -----------------------------------------------------------------------------
%  Grid
%
%  global.css .u-cols is `minmax(0,13rem) minmax(0,1fr)` with a 4rem gap. On a
%  170mm measure that comes out at roughly these numbers. Entries repeat the
%  same idea one level down (.timeline__item, an 8rem date column).
% -----------------------------------------------------------------------------
\newlength{\cvLabelWidth}   \setlength{\cvLabelWidth}{28mm}
\newlength{\cvLabelGap}     \setlength{\cvLabelGap}{9mm}
\newlength{\cvIndent}       \setlength{\cvIndent}{\cvLabelWidth+\cvLabelGap}
\newlength{\cvBodyWidth}    \setlength{\cvBodyWidth}{\textwidth-\cvIndent}

\newlength{\cvDateWidth}    \setlength{\cvDateWidth}{22mm}
\newlength{\cvDateGap}      \setlength{\cvDateGap}{6mm}
\newlength{\cvEntryWidth}   \setlength{\cvEntryWidth}{\cvBodyWidth-\cvDateWidth-\cvDateGap}

\newlength{\cvSectionSep}   \setlength{\cvSectionSep}{5mm}
\newlength{\cvSectionGap}   \setlength{\cvSectionGap}{3.2mm}
\newlength{\cvEntrySep}     \setlength{\cvEntrySep}{1.2mm}
\newlength{\cvRowSep}       \setlength{\cvRowSep}{1mm}

% -----------------------------------------------------------------------------
%  Primitives
% -----------------------------------------------------------------------------

% A date or row key: the condensed sans, --ink-3, sentence case.
\newcommand{\cvlabel}[1]{%
  {\cvlabelfont\cvStepMinusOne\color{CvInkThree}#1}%
}

% A section heading: serif semibold in --ink, as .u-section-head h2.
\newcommand{\cvsectionlabel}[1]{%
  {\cvdisplay\cvStepOne\color{CvInk}#1}%
}

% .u-rule: a hairline in --rule. Spans the content column, not the page:
% \linewidth ignores \leftskip and would run into the right margin. An \hbox
% rather than \rule, so it can be placed in vertical mode with penalties
% either side of it.
\newcommand{\cvrule}{%
  \moveright\cvIndent
  \hbox{\color{CvRule}\vrule height 0.4pt depth 0pt width \cvBodyWidth}%
}

% Close an entry: hairline, then a breakpoint. The \nobreak keeps the rule
% welded to the entry above it, otherwise a page break can strand the rule
% alone at the top of the next page.
\newcommand{\cvclose}[1]{%
  \par\nobreak\vskip#1\nobreak\cvrule\vskip#1\relax
}

% Break the page rather than start a section with less than #1 left on it.
% A section label sits in a zero-height box, so without this it can be left
% stranded at the foot of a page with its rows overleaf.
\newcommand{\cvneedspace}[1]{%
  \par
  \begingroup
  \setlength{\dimen@}{#1}%
  \penalty0
  \ifdim\pagegoal=\maxdimen\else
    \ifdim\dimexpr\pagegoal-\pagetotal\relax<\dimen@\relax\newpage\fi
  \fi
  \endgroup
}

% The section boundary: an ink rule across the full measure, label column
% included, as .u-section-head's border. Entries inside a section are
% separated by the light hairline over the content column only, so the two
% levels never read as the same break.
\newcommand{\cvsectionrule}{%
  \hbox{\color{CvInk}\vrule height 0.6pt depth 0pt width \textwidth}%
}

% A section: rule, air, then a serif heading in the left column with the content
% indented beside it.
%
% The label goes into a \vbox of zero height, so it takes up no room on the
% vertical list and the content that follows starts level with it (CSS
% `align-items: start`). \leftskip rather than a box for the content, so a
% long section still breaks across pages.
\newenvironment{cvsection}[1]{%
  \par\addvspace{\cvSectionSep}%
  \cvneedspace{30mm}%
  \nointerlineskip\cvsectionrule
  \nobreak\vskip\cvSectionGap
  \begingroup
  \parindent=0pt
  \nointerlineskip
  \vbox to 0pt{%
    \hbox{\parbox[t]{\cvLabelWidth}{%
      \RaggedRight\hyphenpenalty=10000\relax\cvsectionlabel{#1}}}%
    \vss
  }%
  \nointerlineskip
  \leftskip=\cvIndent
  \ignorespaces
}{%
  \par\endgroup
}

% One entry: date column, then title over detail, with a hairline beneath.
% Each half is boxed, so an entry never splits across a page.
%   #1 date   #2 title   #3 detail (leave empty for a title-only row)
\newcommand{\cvitem}[3]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{1.1pt}%
    \cvlabel{#1}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight
    {\cvStepZero\bfseries\color{CvInk}#2\par}%
    \ifx\relax#3\relax\else
      \vspace{0.6mm}%
      {\cvStepMinusOne\color{CvInkTwo}#3\par}%
    \fi
  \end{minipage}%
  \ifx\relax#3\relax\cvclose{\cvRowSep}\else\cvclose{\cvEntrySep}\fi
}

% A project: the entry above, plus its schematic under the year. Same pairing
% as ProjectCard on the site, turned on its side to fit the date column.
%   #1 date   #2 figure basename   #3 title   #4 detail
\newcommand{\cvproject}[4]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{1.1pt}%
    \cvlabel{#1}%
    \cvthumb{#2}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight
    {\cvStepZero\bfseries\color{CvInk}#3\par}%
    \vspace{0.6mm}%
    {\cvStepMinusOne\color{CvInkTwo}#4\par}%
  \end{minipage}%
  \cvclose{\cvEntrySep}%
}

% The same, without the closing hairline, for the last project in the list.
\newcommand{\cvprojectlast}[4]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{1.1pt}%
    \cvlabel{#1}%
    \cvthumb{#2}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight
    {\cvStepZero\bfseries\color{CvInk}#3\par}%
    \vspace{0.6mm}%
    {\cvStepMinusOne\color{CvInkTwo}#4\par}%
  \end{minipage}%
  \par
}

% A row with no rule under it, for the last item in a list.
\newcommand{\cvitemlast}[3]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{1.1pt}%
    \cvlabel{#1}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight
    {\cvStepZero\bfseries\color{CvInk}#2\par}%
    \ifx\relax#3\relax\else
      \vspace{0.6mm}%
      {\cvStepMinusOne\color{CvInkTwo}#3\par}%
    \fi
  \end{minipage}%
  \par
}

% A block of prose in the content column, no date beside it. Used where a
% ruled list of near-identical rows would say less than a sentence does.
\newcommand{\cvblock}[1]{%
  \par\nobreak
  \noindent\hspace*{\dimexpr\cvDateWidth+\cvDateGap\relax}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight\cvStepMinusOne\color{CvInkTwo}#1%
  \end{minipage}%
  \par
}

% The article titles under the writing block: quieter than the sentence above
% them, so the block reads as one item rather than a list.
\newcommand{\cvtitles}[1]{%
  \par\addvspace{1.4mm}%
  {\color{CvInkThree}\itshape #1\par}%
}

% A compact one-line row: sans key on the left, running text on the right.
% This is .entry in about.astro.
\newcommand{\cvrow}[2]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{0.6pt}%
    \cvlabel{#1}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight\cvStepMinusOne\color{CvInkTwo}#2%
  \end{minipage}%
  \cvclose{\cvRowSep}%
}

\newcommand{\cvlistrow}[2]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{0.6pt}%
    \cvlabel{#1}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight\cvStepMinusOne\color{CvInkTwo}#2%
  \end{minipage}%
  \par\addvspace{1.6mm}%
}

\newcommand{\cvrowlast}[2]{%
  \par\nobreak
  \noindent
  \begin{minipage}[t]{\cvDateWidth}%
    \RaggedRight\cvStepMinusTwo
    \vspace*{0.6pt}%
    \cvlabel{#1}%
  \end{minipage}%
  \hspace{\cvDateGap}%
  \begin{minipage}[t]{\cvEntryWidth}%
    \RaggedRight\cvStepMinusOne\color{CvInkTwo}#2%
  \end{minipage}%
  \par
}

% A project's schematic, sized to the date column and sitting under its year.
% Same drawing as the plate on the site, framed in --rule-strong as .fig in
% src/components/Figure.astro (the graph paper is left to the screen). These are illustrations, not results: see
% CLAUDE.md section 7, and the note at the foot of the projects section.
\newcommand{\cvthumb}[1]{%
  \par\vspace{1.2mm}%
  \fboxsep=0pt \fboxrule=0.4pt
  \fcolorbox{CvRuleStrong}{CvBgSunk}{%
    \includegraphics[width=\dimexpr\cvDateWidth-0.8pt\relax]%
      {\cvfigurepath #1.pdf}%
  }%
}

% The stack line under a project, as .plate__meta on the site.
% The \par comes first: it closes the detail paragraph while \baselineskip is
% still the detail's, otherwise the smaller size set here would be applied
% retroactively to every line of it.
\newcommand{\cvstack}[1]{%
  \par\addvspace{1mm}%
  {\cvsans\cvStepMinusOne\color{CvInkThree}\RaggedRight #1\par}%
}

% A quiet note in the content column, for the caveat under the projects.
\newcommand{\cvnote}[1]{%
  \par\addvspace{1.4mm}%
  \noindent\hspace*{\dimexpr\cvDateWidth+\cvDateGap\relax}%
  \begin{minipage}{\cvEntryWidth}%
    \RaggedRight\cvsans\cvStepMinusOne\color{CvInkThree}#1%
  \end{minipage}%
  \par
}

% -----------------------------------------------------------------------------
%  Masthead
%
%  The band behind the name is the site's homepage hero: the same Kármán wake
%  from scripts/make_figures.py, on --bg-sunk, under the same scrim. It is
%  drawn as a background layer so it costs no vertical space, and the header
%  text sits on top of it.
%
%   #1 name   #2 role line   #3 contact line
% -----------------------------------------------------------------------------
\newlength{\cvHeroHeight}   \setlength{\cvHeroHeight}{63mm}
\newlength{\cvTailHeight}   \setlength{\cvTailHeight}{13mm}

% Masthead band, this page only.
\newcommand{\cvhero}{%
  \AddToShipoutPictureBG*{%
    \AtPageUpperLeft{%
      \raisebox{-\cvHeroHeight}{%
        \includegraphics[width=\paperwidth,height=\cvHeroHeight]%
          {\cvfigurepath hero-band.pdf}%
      }%
    }%
  }%
}

% The closing band, at the foot of whatever page it is called on. The site
% alternates full-bleed banner and two-column content (CLAUDE.md section 3);
% this is what closes the sequence, and it fills the slack a CV always leaves
% at the end rather than fighting text for room.
\newcommand{\cvtail}{%
  \AddToShipoutPictureBG{%
    \ifnum\value{page}=\getpagerefnumber{cv:last}\relax
      \AtPageLowerLeft{%
        % Lifted clear of the running foot, inside the bottom margin.
        \raisebox{7mm}{%
          \includegraphics[width=\paperwidth,height=\cvTailHeight]%
            {\cvfigurepath tail-band.pdf}%
        }%
      }%
    \fi
  }%
}

\newcommand{\cvheader}[3]{%
  \cvhero
  \begingroup
  \RaggedRight\parindent=0pt
  {\cvlabelfont\cvStepZero\color{CvPencil}Curriculum vitae}\par
  \vspace{2.2mm}%
  {\cvdisplay\cvStepFour\color{CvInk}#1\par}%
  \vspace{2.6mm}%
  {\cvStepOne\color{CvInkTwo}#2\par}%
  \vspace{3.4mm}%
  {\cvStepMinusOne\color{CvInkTwo}#3\par}%
  \endgroup
  \par
}

% Separator between contact links: space, as in the site's footer.
\newcommand{\cvdot}{\hspace{4.5mm}}

% -----------------------------------------------------------------------------
%  Running foot
% -----------------------------------------------------------------------------
\newcommand{\cvfootername}{}
\newcommand{\setcvfooter}[1]{\renewcommand{\cvfootername}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\cvlabel{\cvfootername}}
\fancyfoot[R]{{\cvlabelfont\cvStepMinusOne\color{CvInkThree}%
  \thepage\,/\,\pageref*{cv:last}}}

\endinput
