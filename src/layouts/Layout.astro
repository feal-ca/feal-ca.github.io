---
import "../styles/global.css";
import { profile } from "../data/profile.js";
import ogCards from "../data/og.json";

interface Props {
  title?: string;
  description?: string;
  /** Pages that open with a full-bleed element need no top spacing. */
  flush?: boolean;
  /** Share-card key in src/data/og.json. Defaults to the one matching the route. */
  ogKey?: string;
}

const {
  title,
  description = profile.tagline,
  flush = false,
  ogKey,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${profile.shortName}`
  : `${profile.shortName} · ${profile.role}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;

// Share cards are generated per route by scripts/make_og.py and keyed by the
// last path segment, which is also the project slug under /work/. Anything
// without its own card falls back to the homepage one rather than to nothing.
const cards = ogCards as Record<string, string>;
const routeKey = path.replace(/^\/|\/$/g, "").split("/").pop() || "default";
const ogImage = new URL(
  cards[ogKey ?? routeKey] ?? cards.default,
  Astro.site
).href;

const nav = [
  { href: "/work/", label: "Work" },
  { href: "/writing/", label: "Writing" },
  { href: "/photography/", label: "Photographs" },
  { href: "/about/", label: "About" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.shortName,
  url: Astro.site?.href,
  email: `mailto:${profile.links.email}`,
  jobTitle: "Data science and physical engineering undergraduate",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universitat Politècnica de Catalunya",
  },
  knowsAbout: [
    "Computational fluid dynamics",
    "High-performance computing",
    "Machine learning",
    "Physics-informed neural networks",
  ],
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.tds],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <link rel="preload" href="/fonts/source-serif-4-normal-400-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-semi-condensed-normal-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* The card is a typographic rendering of the page title, so it reads as its own alt. */}
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f8f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e2236" media="(prefers-color-scheme: dark)" />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    {/* Applied before first paint so a stored preference never flashes. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (_) {}
    </script>
  </head>

  <body>
    <a class="u-skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead__inner u-page">
        <a class="wordmark" href="/">
          {profile.shortName}
        </a>

        <nav aria-label="Primary">
          <ul class="nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button
          class="theme"
          type="button"
          data-theme-toggle
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <g class="theme__sun" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
            </g>
            <path
              class="theme__moon"
              fill="currentColor"
              d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.7 8.7 0 1 0 11.1 11.1Z"
            />
          </svg>
        </button>
      </div>
    </header>

    <main id="main" class:list={[!flush && "main--pad"]}>
      <slot />
    </main>

    <footer class="footer">
      <div class="u-page footer__inner">
        <p class="footer__name">
          {profile.name}<span class="u-meta footer__place">{profile.location}</span>
        </p>

        <nav aria-label="Elsewhere">
          <ul class="footer__links">
            <li><a class="u-link" href={`mailto:${profile.links.email}`}>Email</a></li>
            <li><a class="u-link" href={profile.links.github} rel="me noopener noreferrer" target="_blank">GitHub</a></li>
            <li><a class="u-link" href={profile.links.linkedin} rel="me noopener noreferrer" target="_blank">LinkedIn</a></li>
            <li><a class="u-link" href={profile.links.tds} rel="me noopener noreferrer" target="_blank">Towards Data Science</a></li>
            <li><a class="u-link" href={profile.links.cv}>CV (PDF)</a></li>
          </ul>
        </nav>
      </div>

      <p class="u-page u-meta footer__colophon">
        Set in Source Serif 4 and Barlow Semi Condensed. The figures are
        schematic drawings made with matplotlib, not results. Built with Astro.
      </p>
    </footer>

    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

      const current = () =>
        root.dataset.theme ?? (systemDark.matches ? "dark" : "light");

      const sync = () => {
        const dark = current() === "dark";
        button?.setAttribute("aria-pressed", String(dark));
        button?.setAttribute(
          "aria-label",
          dark ? "Switch to light theme" : "Switch to dark theme"
        );
      };

      button?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch (_) {}
        sync();
      });

      // Follow the OS while the visitor has not chosen explicitly.
      systemDark.addEventListener("change", () => {
        if (!root.dataset.theme) sync();
      });

      sync();
    </script>

    <style>
      .masthead {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
        border-bottom: 1px solid var(--rule);
      }

      .masthead__inner {
        display: flex;
        align-items: baseline;
        gap: var(--space-m);
        padding-block: var(--space-s) var(--space-xs);
      }

      .wordmark {
        font-family: var(--font-serif);
        font-size: var(--step-0);
        font-weight: 600;
        text-decoration: none;
        margin-right: auto;
        white-space: nowrap;
      }

      .nav {
        display: flex;
        gap: clamp(0.9rem, 2.2vw, 1.75rem);
        list-style: none;
        padding: 0;
        font-family: var(--font-sans);
        font-size: var(--step-0);
        font-weight: 500;
      }

      .nav a {
        text-decoration: none;
        color: var(--ink-2);
        padding-bottom: 0.2em;
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease;
      }

      .nav a:hover {
        color: var(--ink);
      }

      .nav a[aria-current="page"] {
        color: var(--ink);
        border-bottom-color: var(--pencil);
      }

      .theme {
        display: grid;
        place-items: center;
        align-self: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        color: var(--ink-2);
        background: none;
        border: 1px solid var(--rule-strong);
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .theme:hover {
        color: var(--ink);
        border-color: var(--ink-3);
      }

      .theme__moon { display: none; }

      :root[data-theme="dark"] .theme__sun { display: none; }
      :root[data-theme="dark"] .theme__moon { display: block; }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .theme__sun { display: none; }
        :root:not([data-theme="light"]) .theme__moon { display: block; }
      }

      @media (max-width: 32rem) {
        .nav { gap: 0.85rem; font-size: var(--step--1); }
        .wordmark { font-size: var(--step--1); }
      }

      /* Below ~26rem the wordmark, four nav links and the toggle cannot sit
         on one line. Drop the nav to its own row instead. */
      @media (max-width: 26rem) {
        .masthead__inner {
          flex-wrap: wrap;
          row-gap: 0.25rem;
        }

        .masthead__inner nav {
          order: 3;
          flex-basis: 100%;
        }

        .nav {
          justify-content: space-between;
          gap: 0.5rem;
        }
      }

      .main--pad {
        padding-top: var(--space-xl);
      }

      .footer {
        margin-top: var(--space-2xl);
        padding-block: var(--space-l);
        border-top: 1px solid var(--ink);
      }

      .footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-s) var(--space-l);
      }

      .footer__name {
        font-weight: 600;
      }

      .footer__place {
        margin-left: var(--space-s);
        font-weight: 400;
      }

      .footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        list-style: none;
        padding: 0;
        font-family: var(--font-sans);
        font-size: var(--step-0);
      }

      .footer__colophon {
        margin-top: var(--space-m);
      }
    </style>
  </body>
</html>
