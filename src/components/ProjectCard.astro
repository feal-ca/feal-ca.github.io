---
import Figure from "./Figure.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Large treatment for flagship projects. */
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { title, summary, year, categories, figure, figureAlt, stack } = project.data;
const href = `/work/${project.id}/`;
---

<article class:list={["card", wide && "card--wide"]}>
  <a class="card__hit" href={href}>
    <span class="u-visually-hidden">Read about {title}</span>
  </a>

  <Figure
    name={figure}
    alt={figureAlt}
    ratio={wide ? "16 / 9" : "8 / 5"}
    class="card__fig"
  />

  <div class="card__body">
    <p class="u-label card__meta">
      <span>{categories.join(" · ")}</span><span class="card__year">{year}</span>
    </p>
    <h3 class="card__title">{title}</h3>
    <p class="card__summary">{summary}</p>
    {
      stack.length > 0 && (
        <ul class="card__stack" aria-label="Tools used">
          {stack.slice(0, 4).map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    isolation: isolate;
  }

  /* One stretched hit area so the whole card is clickable, without nesting
     interactive elements inside each other. */
  .card__hit {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .card :global(.card__fig) {
    transition:
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card:hover :global(.card__fig),
  .card:focus-within :global(.card__fig) {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
  }

  /* Drives Figure's own drift animation: the card's overlay hit-area sits
     above the figure, so the figure never receives :hover directly. */
  .card:hover :global(.card__fig .fig__inner svg),
  .card:focus-within :global(.card__fig .fig__inner svg) {
    animation: fig-drift 7s ease-in-out infinite;
  }

  @keyframes fig-drift {
    0%,
    100% {
      transform: scale(1.015) translate(0, 0);
    }
    50% {
      transform: scale(1.045) translate(-1.2%, -0.8%);
    }
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .card__year {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .card__title {
    font-size: var(--step-1);
    color: var(--ink);
    margin-top: var(--space-2xs);
  }

  .card:hover .card__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .card__summary {
    margin-top: var(--space-xs);
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 46ch;
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
  }

  .card__stack li {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
  }

  /* Wide variant: figure left, text right. */
  @media (min-width: 56rem) {
    .card--wide {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .card--wide .card__summary {
      font-size: var(--step-0);
    }

    .card--wide .card__title {
      font-size: var(--step-2);
    }
  }
</style>
