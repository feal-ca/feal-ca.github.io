---
/**
 * Inlines a generated schematic from src/assets/figures.
 *
 * These are inlined rather than served as <img> so the SVG's
 * `var(--fig-*)` colours resolve against the current theme; an <img>
 * would be an isolated document and would render them as invalid.
 *
 * The figures are illustrations, not results. See CLAUDE.md §7.
 */
const figures = import.meta.glob("../assets/figures/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  /** Basename without extension, e.g. "vortex-pinn". */
  name: string;
  /** Describes what the figure shows. Empty string only if truly decorative. */
  alt: string;
  ratio?: string;
  class?: string;
}

const { name, alt, ratio = "8 / 5", class: className = "" } = Astro.props;

const key = `../assets/figures/${name}.svg`;
const svg = figures[key] as string | undefined;

if (!svg) {
  throw new Error(
    `Figure "${name}" not found. Available: ${Object.keys(figures)
      .map((k) => k.split("/").pop()?.replace(".svg", ""))
      .join(", ")}. Run: python3 scripts/make_figures.py`
  );
}
---

<figure
  class:list={["fig", className]}
  style={`--ratio: ${ratio}`}
  role="img"
  aria-label={alt}
>
  <div class="fig__inner" set:html={svg} />
</figure>

<style>
  .fig {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--bg-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .fig__inner,
  .fig__inner :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* What actually moves on hover is content-specific: streamlines flow,
     particles orbit, samples jitter. See scripts/make_figures.py for the
     "anim-*" classes and global.css for the shared @keyframes. Standalone
     use (the project page) hovers/focuses the figure directly; nested use
     (ProjectCard) drives the same classes from the card's own hover state,
     since its overlay link sits above the figure. See ProjectCard's
     matching rules. */
  .fig:hover :global(.anim-flow-line),
  .fig:focus-within :global(.anim-flow-line) {
    stroke-dasharray: 5 4;
    animation: fig-flow 1.1s linear infinite;
  }

  .fig:hover :global(.anim-ctg-trace),
  .fig:focus-within :global(.anim-ctg-trace) {
    stroke-dasharray: 10 6;
    animation: fig-flow-slow 2.2s linear infinite;
  }

  .fig:hover :global(.anim-nbody-mass-0 use),
  .fig:focus-within :global(.anim-nbody-mass-0 use) {
    transform-origin: 288px 180px;
    animation: fig-orbit 10s linear infinite;
  }

  .fig:hover :global(.anim-nbody-mass-1 use),
  .fig:focus-within :global(.anim-nbody-mass-1 use) {
    transform-origin: 288px 180px;
    animation: fig-orbit-rev 14s linear infinite;
  }

  .fig:hover :global(.anim-nbody-mass-2 use),
  .fig:focus-within :global(.anim-nbody-mass-2 use) {
    transform-origin: 288px 180px;
    animation: fig-orbit 19s linear infinite;
  }

  .fig:hover :global(.anim-nbody-mass-3 use),
  .fig:focus-within :global(.anim-nbody-mass-3 use) {
    transform-origin: 288px 180px;
    animation: fig-orbit-rev 26s linear infinite;
  }

  .fig:hover :global(.anim-jitter use),
  .fig:focus-within :global(.anim-jitter use) {
    animation: fig-jitter 1.6s ease-in-out infinite;
  }

  .fig :global(.anim-jitter use:nth-of-type(3n+1)) { animation-delay: -0.3s; }
  .fig :global(.anim-jitter use:nth-of-type(3n+2)) { animation-delay: -0.9s; }

  .fig:hover :global(.anim-optimum),
  .fig:focus-within :global(.anim-optimum) {
    transform-box: fill-box;
    transform-origin: center;
    animation: fig-pulse-scale 1s ease-in-out infinite;
  }

  .fig:hover :global(.anim-lattice-arrow),
  .fig:focus-within :global(.anim-lattice-arrow) {
    animation: fig-pulse-opacity 1.3s ease-in-out infinite;
  }
</style>
