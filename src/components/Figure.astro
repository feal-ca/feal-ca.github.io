---
/**
 * Inlines a generated schematic from src/assets/figures.
 *
 * These are inlined rather than served as <img> so the SVG's
 * `var(--fig-*)` colours resolve against the current theme; an <img>
 * would be an isolated document and would render them as invalid.
 *
 * The figures are illustrations, not results. See CLAUDE.md §7.
 */
const figures = import.meta.glob("../assets/figures/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  /** Basename without extension, e.g. "vortex-pinn". */
  name: string;
  /** Describes what the figure shows. Empty string only if truly decorative. */
  alt: string;
  ratio?: string;
  class?: string;
  /** Run the figure's motion continuously instead of on hover. */
  autoplay?: boolean;
}

const { name, alt, ratio = "8 / 5", class: className = "", autoplay = false } = Astro.props;

const key = `../assets/figures/${name}.svg`;
const svg = figures[key] as string | undefined;

if (!svg) {
  throw new Error(
    `Figure "${name}" not found. Available: ${Object.keys(figures)
      .map((k) => k.split("/").pop()?.replace(".svg", ""))
      .join(", ")}. Run: python3 scripts/make_figures.py`
  );
}
---

<figure
  class:list={["fig", className]}
  style={`--ratio: ${ratio}`}
  role="img"
  aria-label={alt}
  data-autoplay={autoplay || undefined}
>
  <div class="fig__inner" set:html={svg} />
</figure>

<style>
  /* A plate on engineering paper: fine lines every cell, a heavier line
     every fifth, drawn with gradients so it costs nothing and follows the
     theme. The schematic sits on top with a transparent background. */
  .fig {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background-color: var(--bg-sunk);
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:
      calc(var(--cell) * 5) calc(var(--cell) * 5),
      calc(var(--cell) * 5) calc(var(--cell) * 5),
      var(--cell) var(--cell),
      var(--cell) var(--cell);
    background-position: -1px -1px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
  }

  .fig__inner,
  .fig__inner :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Hover motion for the figure's content lives in global.css, keyed on
     .fig or any [data-fig-host] ancestor. */
</style>
