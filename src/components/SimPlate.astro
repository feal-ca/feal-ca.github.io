---
import Figure from "./Figure.astro";
import { SIMS, type SimKind } from "../scripts/sims/config";

/**
 * The top plate of a project page, running a small live simulation of the
 * project's method. The schematic stays underneath as the fallback: without
 * JavaScript, or for a reduced-motion visitor who hasn't pressed play, the
 * drawing is what shows. The simulations live in src/scripts/sims/ and are
 * loaded with dynamic imports, so each page fetches only its own.
 */
interface Props {
  sim: SimKind;
  figure: string;
  figureAlt: string;
}

const { sim, figure, figureAlt } = Astro.props;
const config = SIMS[sim];
const id = `sim-${sim}`;
---

<figure
  class="u-wide sim"
  data-sim={sim}
  data-autoplay={"autoplay" in config && config.autoplay === false ? "false" : undefined}
  aria-labelledby={`${id}-caption`}
>
  <div class="sim__stage">
    <Figure name={figure} alt={figureAlt} ratio="16 / 7" autoplay class="sim__fallback" />
    <canvas class="sim__canvas" role="img" aria-label={config.canvasLabel}></canvas>
  </div>

  <figcaption class="sim__caption" id={`${id}-caption`}>
    <span class="sim__num">Fig. 1</span>
    {config.caption}
  </figcaption>

  <div class="sim__panel" hidden>
    <div class="sim__row">
      <div class="sim__buttons">
        <button class="sim__btn sim__btn--main" type="button" data-sim-play aria-keyshortcuts="Space">Pause</button>
        {
          config.controls
            .filter((c) => c.type === "button")
            .map((c) => (
              <button class="sim__btn" type="button" data-sim-action={c.name} aria-keyshortcuts={c.key}>
                {c.label}
              </button>
            ))
        }
        <button class="sim__btn" type="button" data-sim-reset aria-keyshortcuts="R">Reset</button>
        <button class="sim__btn" type="button" data-sim-expand aria-keyshortcuts="F">Expand</button>
      </div>
      <output class="sim__readout" aria-live="polite"></output>
    </div>

    <div class="sim__row sim__row--controls">
      {
        config.controls.map((c) => {
          if (c.type === "range") {
            return (
              <label class="sim__field" for={`${id}-${c.name}`}>
                <span class="sim__label">{c.label}</span>
                <span class="sim__range">
                  <span class="sim__end" aria-hidden="true">{c.min}</span>
                  <input
                    id={`${id}-${c.name}`}
                    type="range"
                    data-sim-param={c.name}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                  />
                  <span class="sim__end" aria-hidden="true">{c.max}{c.unit === "°" ? "°" : ""}</span>
                </span>
              </label>
            );
          }
          if (c.type === "toggle") {
            return (
              <label class="sim__field sim__check">
                <input type="checkbox" data-sim-param={c.name} checked={c.value === 1} />
                <span>{c.label}</span>
              </label>
            );
          }
          if (c.type === "choice") {
            return (
              <fieldset class="sim__field sim__choice">
                <legend class="sim__label">{c.label}</legend>
                {c.options.map((o) => (
                  <label>
                    <input type="radio" name={`${id}-${c.name}`} value={o.value} data-sim-param={c.name} checked={o.value === c.value} />
                    <span>{o.label}</span>
                  </label>
                ))}
              </fieldset>
            );
          }
          return null;
        })
      }
    </div>

    {
      (config.hint || config.legend) && (
        <div class="sim__row sim__row--notes">
          {config.hint && <p class="sim__hint">{config.hint}</p>}
          {config.legend && (
            <ul class="sim__legend" aria-label="Color key">
              {config.legend.map((l) => (
                <li>
                  <span class={`sim__swatch sim__swatch--${l.token}`} aria-hidden="true" />
                  {l.label}
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
</figure>

<script>
  import type { Palette, RGB, Create, Params, Sim } from "../scripts/sims/types";

  const loaders: Record<string, () => Promise<{ create: Create }>> = {
    lbm: () => import("../scripts/sims/lbm"),
    nbody: () => import("../scripts/sims/nbody"),
    fermi: () => import("../scripts/sims/fermi"),
    surrogate: () => import("../scripts/sims/surrogate"),
    fluid: () => import("../scripts/sims/fluid"),
    beads: () => import("../scripts/sims/beads"),
  };

  const hex = (v: string): RGB => {
    const h = v.trim().replace("#", "");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as RGB;
  };

  const readPalette = (): Palette => {
    const css = getComputedStyle(document.documentElement);
    return {
      accent: hex(css.getPropertyValue("--accent")),
      ink: hex(css.getPropertyValue("--ink")),
      pencil: hex(css.getPropertyValue("--pencil")),
      muted: hex(css.getPropertyValue("--fig-muted")),
      plate: hex(css.getPropertyValue("--bg-sunk")),
    };
  };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("figure[data-sim]")) {
    const kind = root.dataset.sim!;
    const canvas = root.querySelector<HTMLCanvasElement>(".sim__canvas")!;
    const panel = root.querySelector<HTMLElement>(".sim__panel")!;
    const play = root.querySelector<HTMLButtonElement>("[data-sim-play]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-sim-reset]")!;
    const expandBtn = root.querySelector<HTMLButtonElement>("[data-sim-expand]")!;
    const readout = root.querySelector<HTMLOutputElement>(".sim__readout")!;
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-sim-param]"));
    const actions = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sim-action]"));

    const paramOf = (input: HTMLInputElement) =>
      input.type === "checkbox" ? (input.checked ? 1 : 0) : Number(input.value);

    const params = (): Params => {
      const out: Params = {};
      for (const input of inputs) {
        if (input.type === "radio" && !input.checked) continue;
        out[input.dataset.simParam!] = paramOf(input);
      }
      return out;
    };

    loaders[kind]().then(({ create }) => {
      let sim: Sim = create(params());
      const ctx = canvas.getContext("2d")!;
      let palette = readPalette();
      let wanted = !reduce.matches && root.dataset.autoplay !== "false";
      let visible = false;
      let dragging = false;
      let raf = 0;
      let w = 0, h = 0;

      const live = () => root.classList.contains("sim--live");

      const size = () => {
        const r = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const render = () => {
        readout.value = sim.readout();
        if (!(sim.ready?.() ?? true)) return;
        sim.draw(ctx, palette, w, h);
        // The canvas covers the drawing only once it has something to show.
        root.classList.add("sim--live");
      };

      // A paused simulation still has to answer the controls and the
      // pointer, so anything that changes it redraws once. It never starts
      // playback: a reduced-motion visitor chose a still page.
      const touched = () => {
        if (!raf) render();
      };

      const frame = () => {
        raf = 0;
        if (!(wanted && visible && !document.hidden)) return;
        sim.step();
        render();
        raf = requestAnimationFrame(frame);
      };

      const sync = () => {
        play.textContent = wanted ? "Pause" : "Play";
        if (wanted && visible && !raf) raf = requestAnimationFrame(frame);
      };

      const toggle = () => {
        wanted = !wanted;
        sync();
      };

      const reset = () => {
        sim = create(params());
        render();
      };

      const expand = () => {
        if (document.fullscreenElement === root) document.exitFullscreen();
        else root.requestFullscreen?.().catch(() => {});
      };

      play.addEventListener("click", toggle);
      resetBtn.addEventListener("click", reset);
      expandBtn.addEventListener("click", expand);
      if (!root.requestFullscreen) expandBtn.hidden = true;
      document.addEventListener("fullscreenchange", () => {
        expandBtn.textContent = document.fullscreenElement === root ? "Close" : "Expand";
      });

      for (const btn of actions) {
        btn.addEventListener("click", () => {
          sim.action?.(btn.dataset.simAction!);
          touched();
        });
      }

      for (const input of inputs) {
        input.addEventListener("input", () => {
          sim.set(input.dataset.simParam!, paramOf(input));
          touched();
        });
      }

      // Space, R, F and any button's own key, while focus is in the plate.
      root.addEventListener("keydown", (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        const t = e.target as HTMLElement;
        if (t.matches("button, input[type=checkbox], input[type=radio]") && e.key === " ") return;
        const key = e.key.toUpperCase();
        if (e.key === " ") toggle();
        else if (key === "R") reset();
        else if (key === "F") expand();
        else {
          const btn = actions.find((b) => b.getAttribute("aria-keyshortcuts") === key);
          if (!btn) return;
          btn.click();
        }
        e.preventDefault();
      });

      // --- Pointer --------------------------------------------------------
      const at = (e: PointerEvent) => {
        const r = canvas.getBoundingClientRect();
        return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height };
      };

      if (sim.pointer) {
        canvas.style.touchAction = "none";
        canvas.addEventListener("pointerdown", (e) => {
          if (!live()) return;
          dragging = sim.pointer!({ type: "down", ...at(e) });
          if (dragging) canvas.setPointerCapture(e.pointerId);
          touched();
        });
        canvas.addEventListener("pointermove", (e) => {
          const p = at(e);
          if (dragging) {
            sim.pointer!({ type: "move", ...p });
            touched();
          } else if (live()) {
            canvas.style.cursor = sim.cursor?.(p.x, p.y) ?? "default";
          }
        });
        const end = (e: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          sim.pointer!({ type: "up", ...at(e) });
          touched();
        };
        canvas.addEventListener("pointerup", end);
        canvas.addEventListener("pointercancel", end);
      }

      // --- Visibility, size, theme ---------------------------------------
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      }, { threshold: 0.1 }).observe(canvas);

      document.addEventListener("visibilitychange", sync);

      new ResizeObserver(() => {
        size();
        if (live()) render();
      }).observe(canvas);

      const recolor = () => {
        palette = readPalette();
        if (live()) render();
      };
      new MutationObserver(recolor).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", recolor);

      size();
      readout.value = sim.readout();
      panel.hidden = false;
      // Draw the first frame even when paused: a still frame is fine under
      // reduced motion. A sim still warming up keeps the drawing instead.
      render();
      sync();
    });
  }
</script>

<style>
  .sim__stage {
    position: relative;
  }

  .sim__canvas {
    position: absolute;
    inset: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    visibility: hidden;
  }

  .sim__canvas:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Live: hide the drawing (keep its graph paper) and show the canvas. */
  .sim--live .sim__canvas {
    visibility: visible;
  }

  .sim--live :global(.sim__fallback .fig__inner) {
    visibility: hidden;
  }

  .sim__caption {
    margin-top: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 80ch;
  }

  .sim__num {
    color: var(--pencil);
    font-weight: 500;
    margin-right: 0.5em;
  }

  /* --- Control panel: ruled rows under the caption, like an instrument
     log under a figure. ------------------------------------------------ */
  .sim__panel {
    margin-top: var(--space-s);
    border-top: 1px solid var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--ink-2);
  }

  .sim__panel[hidden] {
    display: none;
  }

  .sim__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-xs);
  }

  .sim__row + .sim__row {
    border-top: 1px solid var(--rule);
  }

  .sim__row--controls {
    justify-content: flex-start;
  }

  .sim__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .sim__btn {
    padding: 0.25em 0.85em;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .sim__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sim__btn--main {
    min-width: 5.5rem;
    border-color: var(--ink);
  }

  .sim__readout {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .sim__field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
  }

  .sim__label {
    color: var(--ink-3);
  }

  .sim__range {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--1);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* The slider: an ink rule with tick marks at the ends and a red-pencil
     thumb. Drawn by hand for both engines so it matches the plates. */
  .sim__range input {
    -webkit-appearance: none;
    appearance: none;
    width: min(13rem, 42vw);
    height: 1.5rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .sim__range input::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--ink);
  }

  .sim__range input::-moz-range-track {
    height: 1px;
    background: var(--ink);
  }

  .sim__range input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 0.85rem;
    height: 0.85rem;
    margin-top: calc(-0.425rem + 0.5px);
    border-radius: 50%;
    background: var(--pencil);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--pencil);
  }

  .sim__range input::-moz-range-thumb {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--pencil);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--pencil);
  }

  .sim__range input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sim__check,
  .sim__choice label {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    cursor: pointer;
  }

  .sim__check input,
  .sim__choice input {
    accent-color: var(--pencil);
  }

  .sim__choice {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .sim__choice legend {
    float: left;
    margin-right: var(--space-2xs);
  }

  .sim__row--notes {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .sim__hint {
    color: var(--ink-2);
  }

  .sim__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-m);
    list-style: none;
    padding: 0;
  }

  .sim__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .sim__swatch {
    width: 0.9em;
    height: 0.9em;
    border-radius: 1px;
  }

  .sim__swatch--accent { background: var(--accent); }
  .sim__swatch--pencil { background: var(--pencil); }
  .sim__swatch--ink { background: var(--ink); }
  .sim__swatch--muted { background: var(--fig-muted); }

  /* --- Full screen: the plate fills the screen, controls included. ---- */
  .sim:fullscreen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding: var(--space-m) var(--gutter);
    background: var(--bg);
    overflow: auto;
  }

  .sim:fullscreen .sim__stage {
    width: min(100%, calc((100vh - 15rem) * 16 / 7));
    margin-inline: auto;
  }

  .sim:fullscreen .sim__caption,
  .sim:fullscreen .sim__panel {
    width: min(100%, calc((100vh - 15rem) * 16 / 7));
    margin-inline: auto;
  }

  .sim:fullscreen .sim__caption {
    max-width: none;
  }
</style>
