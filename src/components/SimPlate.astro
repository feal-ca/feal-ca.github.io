---
import Figure from "./Figure.astro";
import { SIMS, type SimKind } from "../scripts/sims/config";

/**
 * The top plate of a project page, running a small live simulation of the
 * project's method. The stage and its caption take the page's prose column;
 * the controls sit in the margin column to the right, the same ruled column
 * the project notes use further down, so the page keeps one grid.
 *
 * The schematic stays underneath as the fallback: without JavaScript, or
 * under reduced motion until play is pressed, the drawing is what shows.
 * The simulations live in src/scripts/sims/ and are loaded with dynamic
 * imports, so each page fetches only its own.
 */
interface Props {
  sim: SimKind;
  figure: string;
  figureAlt: string;
}

const { sim, figure, figureAlt } = Astro.props;
const config = SIMS[sim];
const id = `sim-${sim}`;
---

<figure class="u-page sim" data-sim={sim} aria-labelledby={`${id}-caption`}>
  <div class="sim__main">
    <div class="sim__stage">
      <Figure name={figure} alt={figureAlt} ratio="16 / 7" autoplay class="sim__fallback" />
      <canvas class="sim__canvas" role="img" aria-label={config.canvasLabel}></canvas>
    </div>
    <figcaption class="sim__caption" id={`${id}-caption`}>
      <span class="sim__num">Fig. 1</span>
      {config.caption}
    </figcaption>
  </div>

  <div class="sim__panel" hidden>
    <output class="sim__readout" aria-live="polite"></output>

    <div class="sim__buttons">
      <button class="sim__btn sim__btn--main" type="button" data-sim-play aria-keyshortcuts="Space">Pause</button>
      {
        config.controls
          .filter((c) => c.type === "button")
          .map((c) => (
            <button class="sim__btn" type="button" data-sim-action={c.name} aria-keyshortcuts={c.key}>
              {c.label}
            </button>
          ))
      }
      <button class="sim__btn" type="button" data-sim-reset aria-keyshortcuts="R">Reset</button>
    </div>

    <div class="sim__controls">
      {
        config.controls.map((c) => {
          if (c.type === "range") {
            return (
              <label class="sim__field" for={`${id}-${c.name}`}>
                <span class="sim__label">{c.label}</span>
                <span class="sim__range">
                  <span class="sim__end" aria-hidden="true">{c.min}</span>
                  <input
                    id={`${id}-${c.name}`}
                    type="range"
                    data-sim-param={c.name}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                  />
                  <span class="sim__end" aria-hidden="true">{c.max}{c.unit === "°" ? "°" : ""}</span>
                </span>
              </label>
            );
          }
          if (c.type === "toggle") {
            return (
              <label class="sim__check">
                <input type="checkbox" data-sim-param={c.name} checked={c.value === 1} />
                <span>{c.label}</span>
              </label>
            );
          }
          if (c.type === "choice") {
            return (
              <fieldset class="sim__field sim__choice">
                <legend class="sim__label">{c.label}</legend>
                {c.options.map((o) => (
                  <label>
                    <input type="radio" name={`${id}-${c.name}`} value={o.value} data-sim-param={c.name} checked={o.value === c.value} />
                    <span>{o.label}</span>
                  </label>
                ))}
              </fieldset>
            );
          }
          return null;
        })
      }
    </div>

    {config.hint && <p class="sim__hint">{config.hint}</p>}

    {
      config.legend && (
        <ul class="sim__legend" aria-label="Color key">
          {config.legend.map((l) => (
            <li>
              <span class={`sim__swatch sim__swatch--${l.token}`} aria-hidden="true" />
              {l.label}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</figure>

<script>
  import type { Palette, RGB, Create, Params, Sim } from "../scripts/sims/types";

  const loaders: Record<string, () => Promise<{ create: Create }>> = {
    lbm: () => import("../scripts/sims/lbm"),
    nbody: () => import("../scripts/sims/nbody"),
    fermi: () => import("../scripts/sims/fermi"),
    surrogate: () => import("../scripts/sims/surrogate"),
    fluid: () => import("../scripts/sims/fluid"),
    beads: () => import("../scripts/sims/beads"),
  };

  const hex = (v: string): RGB => {
    const h = v.trim().replace("#", "");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as RGB;
  };

  const readPalette = (): Palette => {
    const css = getComputedStyle(document.documentElement);
    return {
      accent: hex(css.getPropertyValue("--accent")),
      ink: hex(css.getPropertyValue("--ink")),
      pencil: hex(css.getPropertyValue("--pencil")),
      muted: hex(css.getPropertyValue("--fig-muted")),
      plate: hex(css.getPropertyValue("--bg-sunk")),
    };
  };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("figure[data-sim]")) {
    const kind = root.dataset.sim!;
    const canvas = root.querySelector<HTMLCanvasElement>(".sim__canvas")!;
    const panel = root.querySelector<HTMLElement>(".sim__panel")!;
    const play = root.querySelector<HTMLButtonElement>("[data-sim-play]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-sim-reset]")!;
    const readout = root.querySelector<HTMLOutputElement>(".sim__readout")!;
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-sim-param]"));
    const actions = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sim-action]"));

    const paramOf = (input: HTMLInputElement) =>
      input.type === "checkbox" ? (input.checked ? 1 : 0) : Number(input.value);

    const params = (): Params => {
      const out: Params = {};
      for (const input of inputs) {
        if (input.type === "radio" && !input.checked) continue;
        out[input.dataset.simParam!] = paramOf(input);
      }
      return out;
    };

    loaders[kind]().then(({ create }) => {
      let sim: Sim = create(params());
      const ctx = canvas.getContext("2d")!;
      let palette = readPalette();
      let wanted = !reduce.matches && root.dataset.autoplay !== "false";
      let visible = false;
      let dragging = false;
      let raf = 0;
      let w = 0, h = 0;

      const live = () => root.classList.contains("sim--live");

      const size = () => {
        const r = canvas.getBoundingClientRect();
        // 1.5 is sharp enough for these drawings and saves a lot of fill.
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      // The readout is an aria-live region: writing it every frame forces a
      // layout per frame and floods screen readers. Update it only when the
      // text changes, and at most four times a second.
      let shown = "", shownAt = 0;
      const updateReadout = (force = false) => {
        const now = performance.now();
        if (!force && now - shownAt < 250) return;
        const text = sim.readout();
        if (text !== shown) readout.value = shown = text;
        shownAt = now;
      };

      const render = (force = false) => {
        updateReadout(force);
        if (!(sim.ready?.() ?? true)) return;
        sim.draw(ctx, palette, w, h);
        // The canvas covers the drawing only once it has something to show.
        root.classList.add("sim--live");
      };

      // A paused simulation still has to answer the controls and the
      // pointer, so anything that changes it redraws once. It never starts
      // playback: a reduced-motion visitor chose a still page.
      const touched = () => {
        if (raf) updateReadout(true);
        else render(true);
      };

      const frame = () => {
        raf = 0;
        if (!(wanted && visible && !document.hidden)) return;
        sim.step();
        render();
        raf = requestAnimationFrame(frame);
      };

      const sync = () => {
        play.textContent = wanted ? "Pause" : "Play";
        if (wanted && visible && !raf) raf = requestAnimationFrame(frame);
      };

      const toggle = () => {
        wanted = !wanted;
        sync();
      };

      const reset = () => {
        sim = create(params());
        render(true);
      };

      play.addEventListener("click", toggle);
      resetBtn.addEventListener("click", reset);

      for (const btn of actions) {
        btn.addEventListener("click", () => {
          sim.action?.(btn.dataset.simAction!);
          touched();
        });
      }

      for (const input of inputs) {
        input.addEventListener("input", () => {
          sim.set(input.dataset.simParam!, paramOf(input));
          touched();
        });
      }

      // Space, R and any button's own key, while focus is in the plate.
      root.addEventListener("keydown", (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        const t = e.target as HTMLElement;
        if (t.matches("button, input[type=checkbox], input[type=radio]") && e.key === " ") return;
        const key = e.key.toUpperCase();
        if (e.key === " ") toggle();
        else if (key === "R") reset();
        else {
          const btn = actions.find((b) => b.getAttribute("aria-keyshortcuts") === key);
          if (!btn) return;
          btn.click();
        }
        e.preventDefault();
      });

      // --- Pointer --------------------------------------------------------
      const at = (e: PointerEvent) => {
        const r = canvas.getBoundingClientRect();
        return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height };
      };

      if (sim.pointer) {
        canvas.style.touchAction = "none";
        canvas.addEventListener("pointerdown", (e) => {
          if (!live()) return;
          dragging = sim.pointer!({ type: "down", ...at(e) });
          if (dragging) canvas.setPointerCapture(e.pointerId);
          touched();
        });
        canvas.addEventListener("pointermove", (e) => {
          const p = at(e);
          if (dragging) {
            sim.pointer!({ type: "move", ...p });
            touched();
          } else if (live()) {
            canvas.style.cursor = sim.cursor?.(p.x, p.y) ?? "default";
          }
        });
        const end = (e: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          sim.pointer!({ type: "up", ...at(e) });
          touched();
        };
        canvas.addEventListener("pointerup", end);
        canvas.addEventListener("pointercancel", end);
      }

      // --- Visibility, size, theme ---------------------------------------
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      }, { threshold: 0.1 }).observe(canvas);

      document.addEventListener("visibilitychange", sync);

      new ResizeObserver(() => {
        size();
        if (live()) render();
      }).observe(canvas);

      const recolor = () => {
        palette = readPalette();
        if (live()) render();
      };
      new MutationObserver(recolor).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      size();
      panel.hidden = false;
      // Draw the first frame even when paused: a still frame is fine under
      // reduced motion. A sim still warming up keeps the drawing instead.
      render();
      sync();
    });
  }
</script>

<style>
  /* Same columns as the project page body (.body in work/[id].astro): the
     stage takes the left, the panel the 16rem margin column on the right. */
  .sim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    gap: var(--space-m) var(--space-xl);
    align-items: start;
  }

  .sim__stage {
    position: relative;
  }

  .sim__canvas {
    position: absolute;
    inset: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    visibility: hidden;
  }

  /* Live: hide the drawing (keep its graph paper) and show the canvas. */
  .sim--live .sim__canvas {
    visibility: visible;
  }

  .sim--live :global(.sim__fallback .fig__inner) {
    visibility: hidden;
  }

  /* A hidden drawing's CSS animations still run, and restyling its few
     hundred SVG groups every frame cost more than the simulation itself. */
  .sim--live :global(.sim__fallback [class*="anim-"]) {
    animation: none !important;
  }

  .sim__caption {
    margin-top: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 80ch;
  }

  .sim__num {
    color: var(--pencil);
    font-weight: 500;
    margin-right: 0.5em;
  }

  /* --- The panel: a margin note, ruled on the left like the project notes. */
  .sim__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-left: var(--space-m);
    border-left: 1px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .sim__panel[hidden] {
    display: none;
  }

  .sim__readout {
    display: block;
    min-height: 2.8em;
    color: var(--ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .sim__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .sim__btn {
    padding: 0.2em 0.75em;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .sim__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sim__btn:disabled {
    color: var(--ink-3);
    border-color: var(--rule);
    cursor: default;
  }

  .sim__btn--main {
    min-width: 4.75rem;
    border-color: var(--ink);
  }

  .sim__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .sim__field {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sim__label {
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .sim__range {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--1);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* The slider: an ink rule with a red-pencil thumb, drawn by hand for both
     engines so it matches the plates. */
  .sim__range input {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    min-width: 0;
    height: 1.5rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .sim__range input::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--ink);
  }

  .sim__range input::-moz-range-track {
    height: 1px;
    background: var(--ink);
  }

  .sim__range input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 0.85rem;
    height: 0.85rem;
    margin-top: calc(-0.425rem + 0.5px);
    border-radius: 50%;
    background: var(--pencil);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--pencil);
  }

  .sim__range input::-moz-range-thumb {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--pencil);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--pencil);
  }

  .sim__range input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sim__check,
  .sim__choice label {
    display: flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
  }

  .sim__check input,
  .sim__choice input {
    accent-color: var(--pencil);
  }

  .sim__choice {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .sim__hint {
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .sim__legend {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .sim__legend li {
    display: flex;
    align-items: center;
    gap: 0.45em;
  }

  .sim__swatch {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    border-radius: 1px;
  }

  .sim__swatch--accent { background: var(--accent); }
  .sim__swatch--pencil { background: var(--pencil); }
  .sim__swatch--ink { background: var(--ink); }
  .sim__swatch--muted { background: var(--fig-muted); }

  @media (max-width: 56rem) {
    .sim {
      grid-template-columns: minmax(0, 1fr);
    }

    .sim__panel {
      padding: var(--space-s) 0 0;
      border-left: 0;
      border-top: 1px solid var(--ink);
    }
  }
</style>
