---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A full-bleed photographic band. This is the *only* place photography is
 * allowed outside /photography — see CLAUDE.md §2. It never sits in the same
 * grid as a technical figure.
 */
interface Props {
  photos: { src: ImageMetadata; alt: string; title: string; year: number }[];
  eyebrow?: string;
  heading?: string;
  href?: string;
  linkLabel?: string;
  height?: string;
}

const {
  photos,
  eyebrow,
  heading,
  href,
  linkLabel = "See the gallery",
  height = "clamp(14rem, 26vw, 24rem)",
} = Astro.props;
---

<section class="band u-bleed" style={`--band-h: ${height}`}>
  <div class="band__strip">
    {
      photos.map((photo, i) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 48rem) 60vw, 34vw"
          loading="lazy"
          decoding="async"
          class:list={["band__img", i > 1 && "band__img--extra"]}
        />
      ))
    }
  </div>

  {
    (heading || href) && (
      <div class="band__caption u-page">
        <div>
          {eyebrow && <p class="u-label">{eyebrow}</p>}
          {heading && <p class="band__heading">{heading}</p>}
        </div>
        {href && (
          <a class="u-action" href={href}>
            {linkLabel}
          </a>
        )}
      </div>
    )
  }
</section>

<style>
  .band {
    margin-block: var(--space-2xl);
  }

  .band__strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    /* The implicit row must be pinned to the container height. Left as
       `auto` it sizes to the tallest image's natural height — a portrait
       frame then paints ~620px out of a 280px band and covers whatever
       section follows. */
    grid-auto-rows: 100%;
    gap: 2px;
    height: var(--band-h);
    overflow: hidden;
    background: var(--rule);
  }

  .band__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    /* Photographs sit next to warm paper; a touch of desaturation stops them
       shouting over the type without turning them grey. */
    filter: saturate(0.92);
  }

  @media (max-width: 48rem) {
    .band__img--extra {
      display: none;
    }
  }

  .band__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .band__heading {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
    margin-top: var(--space-2xs);
    max-width: 44ch;
  }
</style>
