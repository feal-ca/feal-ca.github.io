---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A full-bleed photographic band. This is the *only* place photography is
 * allowed outside /photography; see CLAUDE.md §2. It never sits in the same
 * grid as a technical figure.
 */
interface Props {
  photos: { src: ImageMetadata; alt: string; title: string; year: number }[];
  heading?: string;
  href?: string;
  linkLabel?: string;
  height?: string;
}

const {
  photos,
  heading,
  href,
  linkLabel = "See the gallery",
  height = "clamp(14rem, 26vw, 24rem)",
} = Astro.props;
---

<section class="band u-bleed" style={`--band-h: ${height}`}>
  <div class="band__strip">
    {
      photos.map((photo, i) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 48rem) 60vw, 34vw"
          loading="lazy"
          decoding="async"
          class:list={["band__img", i > 1 && "band__img--extra"]}
        />
      ))
    }
  </div>

  {
    (heading || href) && (
      <div class="band__caption u-page">
        {heading && <p class="band__heading">{heading}</p>}
        {href && (
          <a class="u-link band__link" href={href}>
            {linkLabel}
          </a>
        )}
      </div>
    )
  }
</section>

<style>
  .band {
    margin-block: var(--space-2xl);
  }

  .band__strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    /* The implicit row must be pinned to the container height. Left as
       `auto` it sizes to the tallest image's natural height, and a portrait
       frame then paints ~620px out of a 280px band and covers whatever
       section follows. */
    grid-auto-rows: 100%;
    gap: 2px;
    height: var(--band-h);
    overflow: hidden;
    background: var(--rule);
  }

  .band__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  @media (max-width: 48rem) {
    .band__img--extra {
      display: none;
    }
  }

  .band__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .band__heading {
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 44ch;
  }

  .band__link {
    font-family: var(--font-sans);
    font-size: var(--step-0);
  }
</style>
