---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import Figure from "../../components/Figure.astro";
import SimPlate from "../../components/SimPlate.astro";
import { articles } from "../../data/writing.js";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, summary, year, figure, figureAlt, stack, links, team, sim } = project.data;

const { Content } = await render(project);

// Articles that reference this project, so the two halves of the site link up.
const related = articles.filter((a) => a.project === project.id);

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const index = all.findIndex((p) => p.id === project.id);
const next = all[(index + 1) % all.length];

const tools = new Intl.ListFormat("en", { style: "long", type: "conjunction" });
---

<Layout title={title} description={summary}>
  <article>
    <header class="u-page head">
      <nav class="crumb u-meta" aria-label="Breadcrumb">
        <a class="u-link" href="/work/">Work</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{year}</span>
      </nav>

      <h1 class="head__title">{title}</h1>
      <p class="head__summary">{summary}</p>
    </header>

    {
      sim ? (
        <div class="plate">
          <SimPlate sim={sim} figure={figure} figureAlt={figureAlt} />
        </div>
      ) : (
        <figure class="u-wide plate">
          <Figure name={figure} alt={figureAlt} ratio="16 / 7" autoplay />
          <figcaption class="plate__caption">
            <span class="plate__num">Fig. 1</span>
            A schematic drawing of the problem, not output from the project.
          </figcaption>
        </figure>
      )
    }

    <div class="u-page body">
      <div class="u-prose">
        <Content />
      </div>

      <aside class="notes" aria-label="Project notes">
        <p class="note">
          <span class="note__head">Year</span>
          {year}
        </p>
        {
          team && (
            <p class="note">
              <span class="note__head">Team</span>
              {team}
            </p>
          )
        }
        {
          stack.length > 0 && (
            <p class="note">
              <span class="note__head">Built with</span>
              {tools.format(stack)}
            </p>
          )
        }
        {
          related.length > 0 && (
            <div class="note">
              <p class="note__head">Written up</p>
              <ul class="note__list">
                {related.map((article) => (
                  <li>
                    <a class="u-link" href={article.url} target="_blank" rel="noopener noreferrer">{article.title}</a>, <cite>Towards Data Science</cite>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          links.length > 0 && (
            <div class="note">
              <p class="note__head">Links</p>
              <ul class="note__list">
                {links.map((link) => (
                  <li>
                    <a class="u-link" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <nav class="u-page next" aria-label="Next project">
      <a class="next__link" href={`/work/${next.id}/`}>
        <span class="u-meta">Next project</span>
        <span class="next__title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Layout>

<style>
  .crumb {
    display: flex;
    gap: 0.5em;
    font-size: var(--step-0);
    margin-bottom: var(--space-m);
  }

  .head__title {
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .head__summary {
    margin-top: var(--space-m);
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 50ch;
  }

  .plate {
    margin-top: var(--space-xl);
  }

  .plate__caption {
    margin-top: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .plate__num {
    color: var(--pencil);
    font-weight: 500;
    margin-right: 0.5em;
  }

  /* Prose on the left at a reading measure; notes in the right margin, the
     way a notebook carries its annotations. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 16rem);
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--ink-2);
    align-self: start;
  }

  .note__head {
    display: block;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .note__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  @media (max-width: 56rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .notes {
      order: -1;
      flex-flow: row wrap;
      gap: var(--space-s) var(--space-l);
      padding: 0 0 var(--space-m);
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  .next {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--ink);
  }

  .next__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .next__title {
    font-size: var(--step-2);
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .next__link:hover .next__title {
    color: var(--accent);
  }
</style>
