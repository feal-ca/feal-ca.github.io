---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Plate from "../../components/Plate.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const flagship = all.filter((p) => p.data.tier === "flagship");
const rest = all.filter((p) => p.data.tier !== "flagship");
---

<Layout
  title="Work"
  description="Projects across computational fluid dynamics, high-performance computing and scientific machine learning."
>
  <header class="u-page page-head">
    <h1 class="page-head__title">Projects</h1>
    <p class="u-prose page-head__lede">
      Projects from my degrees at UPC and from my internship at TU Dresden.
      Several were group projects, and each page says so. Some also have a
      longer write-up on Towards Data Science. The figures are schematic
      drawings of each problem, not results.
    </p>
  </header>

  <section class="u-page flagships" aria-label="Main projects">
    {
      flagship.map((project, i) => (
        <Plate
          project={project}
          number={i + 1}
          layout="side"
          flip={i % 2 === 1}
          ratio="16 / 10"
          level={2}
        />
      ))
    }
  </section>

  <section class="u-page more" aria-labelledby="more-heading">
    <div class="u-section-head">
      <h2 id="more-heading">More projects</h2>
      <p class="u-meta">{rest.length}</p>
    </div>
    <div class="grid">
      {
        rest.map((project, i) => (
          <Plate project={project} number={flagship.length + i + 1} />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-head {
    margin-bottom: var(--space-xl);
  }

  .page-head__title {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .page-head__lede {
    margin-top: var(--space-m);
  }

  .flagships {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .more {
    margin-top: var(--space-2xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-xl) var(--space-l);
  }
</style>
