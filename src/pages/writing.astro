---
import Layout from "../layouts/Layout.astro";
import Reference from "../components/Reference.astro";
import { articles } from "../data/writing.js";
import { profile } from "../data/profile.js";
---

<Layout
  title="Writing"
  description="Articles on simulation, high-performance computing and machine learning, published in Towards Data Science."
>
  <header class="u-page page-head">
    <h1 class="page-head__title">
      Explanations of things I had to work out myself.
    </h1>
    <p class="u-prose page-head__lede">
      I write for <a
        href={profile.links.tds}
        target="_blank"
        rel="noopener noreferrer">Towards Data Science</a
      >, generally about the point where a physical problem meets the machine
      that has to solve it. Every article is free to read.
    </p>
  </header>

  <section class="u-page" aria-labelledby="refs-heading">
    <div class="u-section-head">
      <h2 id="refs-heading">Articles</h2>
      <p class="u-meta">{articles.length}, newest first</p>
    </div>
    <ol class="refs" role="list">
      {articles.map((article, i) => (
        <Reference article={article} number={articles.length - i} />
      ))}
    </ol>
  </section>
</Layout>

<style>
  .page-head {
    margin-bottom: var(--space-xl);
  }

  .page-head__title {
    font-size: var(--step-4);
    max-width: 17ch;
  }

  .page-head__lede {
    margin-top: var(--space-m);
  }

  .refs {
    list-style: none;
    padding: 0;
  }
</style>
