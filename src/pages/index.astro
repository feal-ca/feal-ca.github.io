---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Figure from "../components/Figure.astro";
import Plate from "../components/Plate.astro";
import Reference from "../components/Reference.astro";
import PhotoBand from "../components/PhotoBand.astro";
import { profile } from "../data/profile.js";
import { articles } from "../data/writing.js";
import { featured as featuredPhotos } from "../data/photos.js";

const all = await getCollection("projects");
const [lead, ...rest] = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const latest = articles.slice(0, 3);

const since = new Date(`${profile.now.since}-01T00:00:00Z`).toLocaleDateString(
  "en-US",
  { month: "long", year: "numeric", timeZone: "UTC" }
);
---

<Layout>
  <header class="u-page intro">
    <h1 class="intro__name">{profile.name}</h1>

    <div class="intro__grid">
      <p class="intro__tagline">{profile.tagline}</p>

      <div class="intro__side">
        <p class="intro__now">
          <time class="intro__date" datetime={profile.now.since}>{since}</time>
          {profile.now.text}
        </p>
        <ul class="intro__links">
          <li><a class="u-link" href={`mailto:${profile.links.email}`}>Email</a></li>
          <li><a class="u-link" href={profile.links.cv}>CV (PDF)</a></li>
          <li><a class="u-link" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a class="u-link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a class="u-link" href={profile.links.tds} target="_blank" rel="noopener noreferrer">Towards Data Science</a></li>
        </ul>
      </div>
    </div>
  </header>

  <figure class="u-wide hero">
    <Figure
      name="hero-flow"
      alt="Streamlines bending into the alternating vortices of a Kármán vortex street."
      ratio="16 / 4.6"
    />
    <figcaption class="hero__caption">
      <span class="hero__num">Fig. 1</span>
      Streamlines in a Kármán vortex street, the wake that forms behind a
      cylinder. A schematic drawing, like every figure on this site.
    </figcaption>
  </figure>

  <section class="u-page section" aria-labelledby="projects-heading">
    <div class="u-section-head">
      <h2 id="projects-heading">Projects</h2>
      <p class="u-meta">{rest.length + 1} of {all.length}</p>
    </div>

    <p class="u-prose section__lede">
      These all sit between my two degrees: a physical system worth
      modeling, and the machine learning or parallel computing it takes to
      model it at a scale anyone would care about.
    </p>

    <Plate project={lead} number={2} layout="side" ratio="16 / 10" />

    <div class="plates">
      {rest.map((project, i) => <Plate project={project} number={i + 3} />)}
    </div>

    <p class="section__more">
      <a class="u-link" href="/work/">All {all.length} projects</a>
    </p>
  </section>

  <section class="u-page section" aria-labelledby="writing-heading">
    <div class="u-section-head">
      <h2 id="writing-heading">Writing</h2>
      <p class="u-meta">{articles.length} articles in Towards Data Science</p>
    </div>

    <p class="u-prose section__lede">
      Mostly explanations of things I had to work out myself: a solver
      built from nothing, what a supercomputer asks of you, why
      an old idea in hardware came back. All free to read.
    </p>

    <ol class="refs" role="list">
      {latest.map((article, i) => (
        <Reference article={article} number={articles.length - i} />
      ))}
    </ol>

    <p class="section__more">
      <a class="u-link" href="/writing/">All {articles.length} articles</a>
    </p>
  </section>

  <PhotoBand
    photos={featuredPhotos}
    heading="I take a camera most places I go."
    href="/photography/"
    linkLabel="Photographs"
  />

  <section class="u-page section section--contact" aria-labelledby="contact-heading">
    <div class="u-section-head">
      <h2 id="contact-heading">Contact</h2>
    </div>
    <div class="u-prose">
      <p>
        I'm interested in research and internship work on simulation,
        scientific machine learning and HPC. I'm still partway through my
        bachelor's, so I can't offer a fixed start date, but I'd rather
        hear about something interesting early than not at all. Email is the
        quickest way to reach me:
        <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>.
        The <a href={profile.links.cv}>CV</a> has the full detail.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* --- Intro -------------------------------------------------------------- */
  .intro__name {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-m) var(--space-xl);
    margin-top: var(--space-l);
    align-items: start;
  }

  .intro__tagline {
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    max-width: 30ch;
  }

  .intro__side {
    padding-top: 0.5em;
  }

  .intro__now {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .intro__date {
    display: block;
    color: var(--pencil);
    font-weight: 500;
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    list-style: none;
    padding: 0;
    margin-top: var(--space-m);
    font-family: var(--font-sans);
    font-size: var(--step-0);
  }

  @media (max-width: 48rem) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- Hero plate --------------------------------------------------------- */
  .hero {
    margin-top: var(--space-xl);
  }

  .hero__caption {
    margin-top: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 80ch;
  }

  .hero__num {
    color: var(--pencil);
    font-weight: 500;
    margin-right: 0.5em;
  }

  /* --- Sections ----------------------------------------------------------- */
  .section {
    margin-top: var(--space-2xl);
  }

  .section__lede {
    margin-bottom: var(--space-l);
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-l);
    margin-top: var(--space-xl);
  }

  @media (max-width: 44rem) {
    .plates {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .refs {
    list-style: none;
    padding: 0;
  }

  .section__more {
    margin-top: var(--space-l);
    font-family: var(--font-sans);
    font-size: var(--step-0);
  }

  .section--contact {
    margin-bottom: var(--space-xl);
  }
</style>
