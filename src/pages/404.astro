---
import Layout from "../layouts/Layout.astro";
import Figure from "../components/Figure.astro";
---

<Layout title="Page not found" description="That page does not exist.">
  <div class="u-page wrap">
    <p class="u-meta code">Error 404</p>
    <h1 class="title">This page doesn't exist.</h1>
    <p class="u-prose lede">
      The address doesn't match anything on the site. The work, the writing
      and the photographs are all still where they were.
    </p>
    <p class="actions">
      <a class="u-link" href="/">Back to the homepage</a>
    </p>
  </div>

  <div class="u-wide art" aria-hidden="true">
    <Figure name="vortex-pinn" alt="" ratio="16 / 6" />
  </div>
</Layout>

<style>
  .wrap {
    padding-block: var(--space-xl) 0;
  }

  .title {
    font-size: var(--step-4);
    max-width: 16ch;
    margin-top: var(--space-xs);
  }

  .lede {
    margin-top: var(--space-m);
  }

  .actions {
    margin-top: var(--space-l);
    font-family: var(--font-sans);
    font-size: var(--step-0);
  }

  .code {
    color: var(--pencil);
    font-weight: 500;
  }

  .art {
    margin-top: var(--space-2xl);
    opacity: 0.7;
  }
</style>
