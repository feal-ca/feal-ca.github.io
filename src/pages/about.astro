---
import Layout from "../layouts/Layout.astro";
import PhotoBand from "../components/PhotoBand.astro";
import { profile } from "../data/profile.js";
import { photos } from "../data/photos.js";

const band = photos.filter((p) =>
  ["Canal at dusk", "Moon over the stairs", "Split pomegranates"].includes(p.title)
);

// Timeline dates are "YYYY" or "YYYY-MM" (see profile.js).
const month = (d: string) =>
  new Date(`${d}-01T00:00:00Z`).toLocaleDateString("en-US", {
    month: "short",
    timeZone: "UTC",
  });

const period = ({ start, end }: { start: string; end: string | null }) => {
  if (end === null) return `Since ${start.slice(0, 4)}`;
  const [sy, ey] = [start.slice(0, 4), end.slice(0, 4)];
  if (start.length > 4 && end.length > 4) {
    return sy === ey
      ? `${month(start)}–${month(end)} ${ey}`
      : `${month(start)} ${sy}–${month(end)} ${ey}`;
  }
  return sy === ey ? sy : `${sy}–${ey}`;
};
---

<Layout
  title="About"
  description="Data science and physical engineering undergraduate at UPC, on the CFIS program."
>
  <header class="u-page page-head">
    <h1 class="page-head__title">{profile.name}</h1>
  </header>

  <section class="u-page bio" aria-label="Biography">
    <div class="u-prose">
      <p>
        I'm taking two degrees at the same time at the Universitat Politècnica
        de Catalunya: Data Science and Engineering, and Physical Engineering.
        That's possible through CFIS, which admits a small group each year
        through its own entrance exam in math and physics. I'm in my fourth
        year, with an 8.75/10 average across both.
      </p>
      <p>
        This summer I was a research intern with the Physics of Life group at
        TU Dresden. I simulated electromagnetic fields propagating through a
        specimen and the objective lens, as virtual instrumentation for
        learned brightfield imaging. On the side, I built a graph neural
        network for multiple scattering between beads.
      </p>
      <p>
        Most of my projects use both degrees. For the Formula 1 wing, we used
        CFD for ground truth and a surrogate model to keep the search
        affordable. The vortex-shedding network needed the Navier-Stokes
        equations in its loss function to reproduce the wake.
      </p>
      <p>
        I also write for <a
          href={profile.links.tds}
          target="_blank"
          rel="noopener noreferrer">Towards Data Science</a
        >, mostly about simulation and HPC. In 2022–2023 I taught robotics to
        school students (Arduino, micro:bit, 3D printing), and I still
        volunteer at Linux and 3D-printing workshops.
      </p>
      <p>
        Outside of that I fence and take photographs. I speak Catalan, Spanish
        and English, and I'm learning Arabic.
      </p>
      <p>
        After the degrees I'm considering industry, a PhD, or an industrial
        PhD.
      </p>
    </div>

    <aside class="notes" aria-label="In brief">
      <p class="note">
        <span class="note__head">Now</span>
        {profile.now.text}
      </p>
      <p class="note">
        <span class="note__head">Based in</span>
        {profile.location}
      </p>
      <p class="note">
        <span class="note__head">CV</span>
        <a class="u-link" href={profile.links.cv}>Print (PDF)</a>,{" "}
        <a class="u-link" href={profile.links.cvDark}>blueprint (PDF)</a>
      </p>
    </aside>
  </section>

  <PhotoBand photos={band} height="clamp(11rem, 20vw, 18rem)" />

  <section class="u-page section" aria-labelledby="experience">
    <div class="u-section-head">
      <h2 id="experience">Experience and education</h2>
    </div>
    <ol class="entries" role="list">
      {
        profile.timeline.map((item) => (
          <li class="entry">
            <p class="entry__when">{period(item)}</p>
            <div>
              <h3 class="entry__title">{item.title}</h3>
              <p class="entry__detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="u-page section" aria-labelledby="skills">
    <div class="u-section-head">
      <h2 id="skills">Skills</h2>
    </div>
    <dl class="entries">
      {
        profile.skills.map((group) => (
          <div class="entry">
            <dt class="entry__when">{group.group}</dt>
            <dd class="entry__list">{group.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="u-page section" aria-labelledby="awards">
    <div class="u-section-head">
      <h2 id="awards">Awards and activities</h2>
    </div>
    <ul class="entries" role="list">
      {
        profile.awards.map((award) => (
          <li class="entry">
            <p class="entry__when">{award.when}</p>
            <p class="entry__list">{award.what}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="u-page section" aria-labelledby="contact">
    <div class="u-section-head">
      <h2 id="contact">Contact</h2>
    </div>
    <div class="u-prose">
      <p>
        I'm interested in research and internship positions. I'm still
        finishing my degrees, so I can't commit to a fixed start date yet.
      </p>
      <ul class="contact" role="list">
        <li><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
        <li><a href={profile.links.github} target="_blank" rel="noopener noreferrer">github.com/Feal-ca</a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li>
          <a href={profile.links.cv}>Curriculum vitae (PDF)</a>, or the{" "}
          <a href={profile.links.cvDark}>blueprint version</a> for reading on
          a screen
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .page-head__title {
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  /* Same arrangement as a project page: prose at a reading measure, notes
     in the right margin. */
  .bio {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 16rem);
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-l);
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--ink-2);
    align-self: start;
  }

  .note__head {
    display: block;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  @media (max-width: 56rem) {
    .bio {
      grid-template-columns: minmax(0, 1fr);
    }

    .notes {
      order: -1;
      padding: 0 0 var(--space-m);
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  .bio .u-prose {
    font-size: var(--step-0);
  }

  .bio .u-prose > p:first-child {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink);
  }

  .section {
    margin-top: var(--space-2xl);
  }

  /* One list style for experience, skills and awards: a date or group in
     the sans on the left, the entry in the serif on the right. */
  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-l);
    padding-block: var(--space-s);
  }

  .entry + .entry {
    border-top: 1px solid var(--rule);
  }

  .entry__when {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1em;
  }

  .entry__title {
    font-size: var(--step-0);
    line-height: 1.4;
  }

  .entry__detail {
    margin-top: var(--space-2xs);
    color: var(--ink-2);
    font-size: var(--step--1);
    max-width: 60ch;
  }

  .entry__list {
    margin: 0;
    color: var(--ink-2);
    max-width: 60ch;
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contact {
    list-style: none;
    padding: 0;
  }
</style>
